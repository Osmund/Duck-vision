[Unit]
Description=Duck-Vision Live Stream (Flask)
Documentation=https://github.com/admog/Duck-Vision
After=network-online.target duck-vision.service
Wants=network-online.target

[Service]
Type=simple
User=admog
Group=admog
WorkingDirectory=/home/admog/Code/Duck-vision
Environment="PATH=/home/admog/Code/Duck-vision/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="LIVE_STREAM_PORT=8091"

ExecStart=/home/admog/Code/Duck-vision/.venv/bin/python3 /home/admog/Code/Duck-vision/src/live_stream_app.py

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=duck-vision-live

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
