# MQTT Configuration
MQTT_BROKER=oduckberry-2.local  # MQTT broker hostname/IP (Pi 4)
MQTT_PORT=1883
MQTT_CLIENT_ID=duck-vision
MQTT_USERNAME=
MQTT_PASSWORD=

# Topics
MQTT_TOPIC_VISION_TO_SAMANTHA=duck/vision/events
MQTT_TOPIC_SAMANTHA_TO_VISION=duck/samantha/commands
MQTT_TOPIC_FACE_DETECTED=duck/vision/face
MQTT_TOPIC_OBJECT_DETECTED=duck/vision/object

# Camera Settings
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Face Recognition Settings
FACE_RECOGNITION_TOLERANCE=0.6
FACE_DETECTION_INTERVAL=1.0  # sekunder mellom deteksjoner
MIN_CONFIDENCE=0.5

# Voice Recognition Settings
VOICE_MATCH_THRESHOLD=0.70

# API Keys (for singing/voice services)
OPENAI_API_KEY=sk-...your-key-here...
AZURE_TTS_KEY=...your-key-here...
AZURE_TTS_REGION=westeurope

# Paths
KNOWN_FACES_DIR=./data/known_faces
FACE_ENCODINGS_FILE=./data/face_encodings.pkl
KNOWN_VOICES_DIR=./data/known_voices
MODELS_DIR=./models
